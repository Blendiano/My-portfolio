# Environment variables for the contact form endpoint (api/contact.js).
#
# In production set these in Vercel → Project → Settings → Environment Variables
# (add them to Production, Preview and Development as needed).
# Locally, `vercel dev` reads a .env file — copy this file to .env and fill it in.
#
# Never commit the filled-in .env file.

# ---------------------------------------------------------------------------
# Required — the SMTP mailbox that sends the notification
# ---------------------------------------------------------------------------

# The SMTP server address
SMTP_HOST=smtp.gmail.com

# The SMTP port. 587 = STARTTLS (most providers), 465 = implicit TLS
SMTP_PORT=587

# "true" forces TLS on connect. Leave blank for the default
# (true on port 465, false elsewhere)
SMTP_SECURE=false

# The mailbox username — usually the full email address
SMTP_USER=your-email@gmail.com

# The mailbox password.
# Gmail, Outlook and Yahoo require an APP PASSWORD here, not the account password:
#   Gmail   -> Google Account → Security → 2-Step Verification → App passwords
#              (2-Step Verification must be ON first, then create an app password
#               named "Portfolio" and copy the 16-character code)
#   Outlook -> account.microsoft.com → Security → Advanced security → App passwords
#   Yahoo   -> Yahoo Account Security → Generate app password
SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# Optional — who the message is sent to and from
# ---------------------------------------------------------------------------
# Both default to SMTP_USER when left blank.

# Where the messages land in your inbox
CONTACT_TO_EMAIL=your-email@gmail.com

# The sender shown on the notification. Most providers require this to match
# the account you authenticate with.
CONTACT_FROM_EMAIL=Portfolio <your-email@gmail.com>

# ---------------------------------------------------------------------------
# Other providers — swap the values above for these
# ---------------------------------------------------------------------------
# Outlook / Hotmail (Microsoft 365)
#   SMTP_HOST=smtp.office365.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# Yahoo
#   SMTP_HOST=smtp.yahoo.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#
# Zoho Mail
#   SMTP_HOST=smtp.zoho.com
#   SMTP_PORT=465
#   SMTP_SECURE=true
